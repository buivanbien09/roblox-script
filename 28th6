local function getESPMovementTarget()
    if autoMoveESPTargetMode == "Nearest" and HubState.GetNearestESPTarget then
        if not (Options.ESPTeamCheck and Options.ESPTeamCheck.Value) then
            return HubState.GetNearestESPTarget()
        end
    end

    local bestPlayer, bestRoot
    local bestScore = math.huge
    local camera = workspace.CurrentCamera
    local localPlayer = game:GetService("Players").LocalPlayer

    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local sameTeam = false
            if Options.ESPTeamCheck and Options.ESPTeamCheck.Value and isSameTeamHelper then
                local mode = (Options.TeamCheckMode and Options.TeamCheckMode.Value) or "Auto Detect"
                local ok, result = pcall(isSameTeamHelper, player, true, mode)
                sameTeam = ok and result == true
            end

            if root and humanoid and humanoid.Health > 0 and not sameTeam then
                local score
                if autoMoveESPTargetMode == "Lowest Health" then
                    score = humanoid.Health
                elseif autoMoveESPTargetMode == "Crosshair" and camera then
                    local screenPoint, visible = camera:WorldToViewportPoint(root.Position)
                    if visible and screenPoint.Z > 0 then
                        local center = camera.ViewportSize / 2
                        score = (Vector2.new(screenPoint.X, screenPoint.Y) - center).Magnitude
                    end
                else
                    local localCharacter = localPlayer and localPlayer.Character
                    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
                    score = localRoot and (root.Position - localRoot.Position).Magnitude or math.huge
                end

                if score and score < bestScore then
                    bestScore = score
                    bestPlayer, bestRoot = player, root
                end
            end
        end
    end

    return bestPlayer, bestRoot
end

local function isESPMovementBlocked(root, direction, character)
    if direction.Magnitude <= 0 then return false end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { character }
    rayParams.IgnoreWater = true

    local origin = root.Position + Vector3.new(0, 1.5, 0)
    local hit = workspace:Raycast(origin, direction.Unit * 4, rayParams)
    return hit ~= nil and math.abs(hit.Normal.Y) < 0.7
end

