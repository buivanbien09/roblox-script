local autoStateFile = "28th6Hub/auto_toggle_state.json"
local autoStateSaving = false
local autoStateLoaded = false

local function getAutoToggleState()
    local state = {}
    for name, option in pairs(Options) do
        if option then
            local value = option.Value
            local valueType = type(value)
            -- Lưu Toggle, Slider và Dropdown; bỏ qua kiểu không thể JSON encode.
            if valueType == "boolean"
                or valueType == "number"
                or valueType == "string"
                or valueType == "table" then
                state[name] = value
            end
        end
    end
    return state
end

local function saveAutoToggleState()
    if autoStateSaving or not writefile or not isfolder then return end
    autoStateSaving = true
    pcall(function()
        if not isfolder("28th6Hub") then
            makefolder("28th6Hub")
        end
        local HttpService = game:GetService("HttpService")
        writefile(autoStateFile, HttpService:JSONEncode(getAutoToggleState()))
    end)
    autoStateSaving = false
end

local function loadAutoToggleState()
    if autoStateLoaded or not readfile or not isfile then return end
    autoStateLoaded = true
    pcall(function()
        if not isfile(autoStateFile) then return end
        local HttpService = game:GetService("HttpService")
        local state = HttpService:JSONDecode(readfile(autoStateFile))
        if type(state) ~= "table" then return end
        for name, value in pairs(state) do
            if Options[name] and type(value) == "boolean" then
                Options[name]:SetValue(value)
            end
        end
    end)
end

