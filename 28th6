local function sendJoinQueue(mode)
    local RS = game:GetService("ReplicatedStorage")
    local matchmakingRemotes = RS:FindFirstChild("MatchmakingRemotes")
    local joinQueue = matchmakingRemotes and matchmakingRemotes:FindFirstChild("JoinQueue", true)
    if not joinQueue or not joinQueue:IsA("RemoteFunction") then
        return false, "Matchmaking JoinQueue remote not found"
    end

    local ok, result = pcall(function()
        return joinQueue:InvokeServer(tostring(mode or "3v3"), "Casual")
    end)

    if not ok then
        return false, result
    end
    return true, result
end

local function sendBackToLobby()
    local RS = game:GetService("ReplicatedStorage")
    local matchAction = RS:FindFirstChild("MatchAction")
    if not matchAction then
        return false, "MatchAction not found"
    end

    local ok, result = pcall(function()
        if matchAction:IsA("RemoteEvent") then
            matchAction:FireServer("BackToLobby")
            return true
        elseif matchAction:IsA("RemoteFunction") then
            return matchAction:InvokeServer("BackToLobby")
        end
        error("MatchAction is not a remote")
    end)

    return ok, result
end

local function isGuiVisible(object)
    return object ~= nil and object:IsA("GuiObject") and object.Visible
end

local function isEndMatchOrLobbyUiVisible()
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end

    local mainUI = playerGui:FindFirstChild("MainUI")
    local matchEnd = mainUI and mainUI:FindFirstChild("MatchEnd")
    if isGuiVisible(matchEnd) then
        local playAgain = matchEnd:FindFirstChild("PlayAgain")
        local leave = matchEnd:FindFirstChild("Leave")
        if isGuiVisible(playAgain) or isGuiVisible(leave) then
            return true
        end
    end

    local scoreLeaderboard = playerGui:FindFirstChild("ScoreLeaderboard")
    local frame = scoreLeaderboard and scoreLeaderboard:FindFirstChild("Frame")
    if frame then
        local redScore = frame:FindFirstChild("RedScore")
        local neutralScore = frame:FindFirstChild("NeutralScore")
        local redLobby = redScore and redScore:FindFirstChild("Lobby")
        local neutralLobby = neutralScore and neutralScore:FindFirstChild("Lobby")
        if isGuiVisible(redLobby) or isGuiVisible(neutralLobby) then
            return true
        end
    end

    return false
end

local function isQueueOrMatchUiVisible()
    local player = game:GetService("Players").LocalPlayer
    local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
    if not playerGui then return false end

    local mainUI = playerGui:FindFirstChild("MainUI")
    local queue = mainUI and mainUI:FindFirstChild("Queue")
    local mapVoting = mainUI and mainUI:FindFirstChild("MapVoting")
    local mapVotingEnd = mainUI and mainUI:FindFirstChild("MapVotingEnd")

    return isGuiVisible(queue) or isGuiVisible(mapVoting) or isGuiVisible(mapVotingEnd)
end

