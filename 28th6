                local zHum = z:FindFirstChildOfClass("Humanoid")
                local zRoot = z:FindFirstChild("HumanoidRootPart")
                if zHum and zHum.Health > 0 and zRoot and zRoot.Parent then
                    local distance = (myRoot.Position - zRoot.Position).Magnitude
                    if distance < nearestDist then
                        nearestDist = distance
                        nearestRoot = zRoot
                    end
                end
            end
        end

        if not nearestRoot then return end

        local stopDist = tonumber(CS.autoFlyStopDist) or 8
        local speed = tonumber(CS.autoFlySpeed) or 60
        if nearestDist <= stopDist then
            myRoot.AssemblyLinearVelocity = Vector3.new(0, myRoot.AssemblyLinearVelocity.Y, 0)
            return
        end

        local offset = nearestRoot.Position - myRoot.Position
        if offset.Magnitude <= 0 then return end
        local dir = offset.Unit
        local horizontalDir = Vector3.new(dir.X, 0, dir.Z)
        if horizontalDir.Magnitude > 0 then horizontalDir = horizontalDir.Unit end

        local yDiff = nearestRoot.Position.Y - myRoot.Position.Y
        local yVel = myRoot.AssemblyLinearVelocity.Y
        if math.abs(yDiff) > 3 then
            yVel = math.clamp(yDiff * 2, -speed, speed)
        end

        myRoot.AssemblyLinearVelocity = Vector3.new(
            horizontalDir.X * speed,
            yVel,
            horizontalDir.Z * speed
        )
    end))

