        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end

        local ammo = tool:GetAttribute("_ammo") or 0
        if ammo <= 0 then
            tryReload(tool)
            return
        end

        if now - killAuraV6State.lastFire < killAuraV6State.FireDelay then return end
        killAuraV6State.lastFire = now

        fakeShoot(tool, target)
    end)

