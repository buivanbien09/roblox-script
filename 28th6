                jorkin = true 

                local isR15 = myHum.RigType == Enum.HumanoidRigType.R15
                animObj = Instance.new("Animation")
                animObj.AnimationId = not isR15 and "rbxassetid://72042024" or "rbxassetid://698251653"

                local animator = myHum:FindFirstChildOfClass("Animator") or Instance.new("Animator", myHum)
                local ok, tr = pcall(function() return animator:LoadAnimation(animObj) end)
                if not ok or not tr then return end
                track = tr
                track:Play()
                track:AdjustSpeed(isR15 and 0.7 or 0.65)
                track.TimePosition = 0.6

                jorkinLoop = task.spawn(function()
