local function loadRemoteLibrary(name, url)
    local source = game:HttpGet(url, true)
    assert(type(source) == "string" and #source > 0, name .. " HttpGet returned empty source")

    local fn, compileErr = loadstring(source)
    assert(fn, name .. " loadstring failed: " .. tostring(compileErr))

    local result = fn()
    assert(result ~= nil, name .. " returned nil")
    return result
end

