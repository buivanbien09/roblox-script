    local patchedValues = { noSpread = {}, infiniteAmmo = {}, rapidFire = {} }

    
    local function rememberValue(featureKey, obj, key)
        if not obj then return end
        local store = patchedValues[featureKey]
        if not store[obj] then store[obj] = {} end
        if store[obj][key] == nil then
            local ok, val = pcall(function() return obj[key] end)
            if ok and type(val) == "number" then
                store[obj][key] = val
            end
        end
    end

    local function safeSet(featureKey, obj, key, val)
        if not obj then return end
        rememberValue(featureKey, obj, key)
        pcall(function() obj[key] = val end)
    end

    local patchedModules = { noSpread = {}, infiniteAmmo = {}, rapidFire = {} }
    local patchedTools = { noSpread = {}, infiniteAmmo = {}, rapidFire = {} }
    local weaponPatchState = { tool = nil, elapsed = 0 }

    local function newPatchCache()
        return {}
    end

    local function shouldPatchModule(desc)
        local lname = string.lower(desc.Name)
        return lname:find("config", 1, true)
            or lname:find("setting", 1, true)
            or lname:find("stat", 1, true)
            or lname:find("weapon", 1, true)
            or lname:find("gun", 1, true)
            or lname:find("ammo", 1, true)
            or lname:find("fire", 1, true)
            or lname:find("spread", 1, true)
            or lname:find("recoil", 1, true)
    end

    local function restoreFeatureValues(featureKey)
        local store = patchedValues[featureKey]
        if store then
            for obj, keys in pairs(store) do
                for key, original in pairs(keys) do
                    pcall(function() obj[key] = original end)
                end
            end
            patchedValues[featureKey] = {}
        end
        patchedModules[featureKey] = newPatchCache()
        patchedTools[featureKey] = newPatchCache()
    end

    
    local function patchTool(featureKey, tool, keywordSets)
        if not tool or not tool:IsA("Tool") then return end
        patchedModules[featureKey] = patchedModules[featureKey] or newPatchCache()
        patchedTools[featureKey] = patchedTools[featureKey] or newPatchCache()

        local toolCache = patchedTools[featureKey]
        local descendantCache = toolCache[tool]
        if not descendantCache then
            descendantCache = newPatchCache()
            toolCache[tool] = descendantCache
        end

        for _, desc in ipairs(tool:GetDescendants()) do
            if not descendantCache[desc] then
                descendantCache[desc] = true
                local lname = string.lower(desc.Name)
                if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                    for _, ks in ipairs(keywordSets) do
                        for _, kw in ipairs(ks.keywords) do
                            if lname:find(kw, 1, true) then
                                safeSet(featureKey, desc, "Value", ks.value)
                                break
                            end
                        end
                    end
                elseif desc:IsA("ModuleScript") and shouldPatchModule(desc) and not patchedModules[featureKey][desc] then
                    patchedModules[featureKey][desc] = true
                    pcall(function()
                        local m = require(desc)
                        if type(m) ~= "table" then return end
                        for k, v in pairs(m) do
                            if type(v) == "number" then
                                local lk = string.lower(tostring(k))
                                for _, ks in ipairs(keywordSets) do
                                    for _, kw in ipairs(ks.keywords) do
                                        if lk:find(kw, 1, true) then
                                            rememberValue(featureKey, m, k)
                                            m[k] = ks.value
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
            end
        end
    end

    local function patchCurrentTool(tool)
        if CS.noSpreadEnabled and tool then
            patchTool("noSpread", tool, {
                { keywords = {"spread","spreadradius","spread_radius","accuracy","inaccuracy"}, value = 0 },
                { keywords = {"recoil","recoilamount","recoil_amount"},                          value = 0 },
            })
        end
        if CS.infiniteAmmoEnabled and tool then
            patchTool("infiniteAmmo", tool, {
                { keywords = {"ammo","magazine","clip","bullet","reserve","maxammo","maxbullet"}, value = 2147483647 },
            })
        end
        if CS.rapidFireEnabled and tool then
            patchTool("rapidFire", tool, {
                { keywords = {"firerate","fire_rate","firedelay","fire_delay","shotdelay",
                              "shot_delay","delay","cooldown","rpm","rate"}, value = 0 },
            })
        end
    end

    local function forceInfiniteAmmo(tool)
        if not CS.infiniteAmmoEnabled or not tool then return end
        for _, desc in ipairs(tool:GetDescendants()) do
            local lname = string.lower(desc.Name)
            if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                if lname:find("ammo", 1, true) or lname:find("magazine", 1, true)
                or lname:find("clip", 1, true) or lname:find("bullet", 1, true)
                or lname:find("reserve", 1, true) then
                    pcall(function()
                        desc.Value = desc:IsA("IntValue") and 2147483647 or 1e15
                    end)
                end
            end
        end
    end

    -- ⭐ HOOK AMMO VALUE - ĐÉO CHO GIẢM
    local function enableInfiniteAmmoHook(tool)
        if not tool or not tool:IsA("Tool") then return end
        if CS.infiniteAmmoHooked[tool] then return end
        CS.infiniteAmmoHooked[tool] = true

        for _, desc in ipairs(tool:GetDescendants()) do
            local lname = string.lower(desc.Name)
            if (desc:IsA("NumberValue") or desc:IsA("IntValue"))
               and (lname:find("ammo", 1, true) or lname:find("magazine", 1, true)
                    or lname:find("clip", 1, true) or lname:find("bullet", 1, true)
                    or lname:find("reserve", 1, true)) then
                local maxValue = desc:IsA("IntValue") and 2147483647 or 1e15
                local originalValue = desc.Value
                pcall(function() desc.Value = maxValue end)
                local conn = desc:GetPropertyChangedSignal("Value"):Connect(function()
                    if not CS.infiniteAmmoEnabled then return end
                    if desc.Value < maxValue then
                        pcall(function() desc.Value = maxValue end)
                    end
                end)
                table.insert(CS.infiniteAmmoConns, {
                    conn = conn, value = desc, original = originalValue, tool = tool
                })
            end
        end
    end

    local function disableInfiniteAmmoHook()
        for _, entry in ipairs(CS.infiniteAmmoConns) do
            pcall(function() entry.conn:Disconnect() end)
            pcall(function() entry.value.Value = entry.original end)
        end
        CS.infiniteAmmoConns = {}
        CS.infiniteAmmoHooked = {}
        HubState.InfiniteAmmoConns = CS.infiniteAmmoConns
    end

    
