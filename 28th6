-- Format SaveManager output so config files are easy to read/edit manually.
local function prettyJson(json)
    local result = {}
    local indent = 0
    local inString = false
    local escaped = false
    local pendingSpace = false

    local function add(value)
        result[#result + 1] = value
    end

    for i = 1, #json do
        local char = json:sub(i, i)

        if inString then
            add(char)
            if escaped then
                escaped = false
            elseif char == "\\" then
                escaped = true
            elseif char == '"' then
                inString = false
            end
        elseif char == '"' then
            if pendingSpace then add(" "); pendingSpace = false end
            add(char)
            inString = true
        elseif char == "{" or char == "[" then
            if pendingSpace then add(" "); pendingSpace = false end
            add(char)
            indent += 1
            add("\n" .. string.rep("    ", indent))
        elseif char == "}" or char == "]" then
            indent -= 1
            add("\n" .. string.rep("    ", indent) .. char)
        elseif char == "," then
            add(",\n" .. string.rep("    ", indent))
        elseif char == ":" then
            add(": ")
        elseif char == " " or char == "\n" or char == "\r" or char == "\t" then
            -- JSONEncode does not need whitespace preserved.
        else
            add(char)
        end
    end

    return table.concat(result)
end

local saveConfigOriginal = SaveManager.Save
SaveManager.Save = function(self, name, ...)
    local ok, err = saveConfigOriginal(self, name, ...)
    if ok and name then
        pcall(function()
            local path = string.format("%s/settings/%s.json", self.Folder, name)
            if isfile(path) then
                writefile(path, prettyJson(readfile(path)))
            end
        end)
    end
    return ok, err
end

