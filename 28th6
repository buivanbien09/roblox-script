                            if track.TimePosition >= targetTime or track.TimePosition < 0.6 then
                                track.TimePosition = 0.6
                            end
                        else
                            break
                        end
                    end
                end)
            end))
            
            trackConnection(tool.Unequipped:Connect(stopTomfoolery))
            trackConnection(myHum.Died:Connect(stopTomfoolery))
            
