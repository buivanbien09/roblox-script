        end

        local offset = Vector3.new(
            math.cos(killAuraV6State.orbitAngle) * killAuraV6State.OrbitRadius,
            killAuraV6State.OrbitHeight,
            math.sin(killAuraV6State.orbitAngle) * killAuraV6State.OrbitRadius
