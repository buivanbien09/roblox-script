    local isVisible
    isVisible = function(targetPart)
        Camera = workspace.CurrentCamera or Camera
        local cam = Camera
        if not cam or not targetPart then return false end
        local origin    = cam.CFrame.Position
        local direction = targetPart.Position - origin
        if direction.Magnitude <= 0 then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local excludeList = {cam}
        if LocalPlayer.Character then table.insert(excludeList, LocalPlayer.Character) end
        params.FilterDescendantsInstances = excludeList
        local result = workspace:Raycast(origin, direction, params)
        return result == nil or result.Instance:IsDescendantOf(targetPart.Parent)
    end

    
    local function isValidTarget(char)
        if not char or char == LocalPlayer.Character or not char.Parent then return false end
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0.1 then return false end
        if hum:GetState() == Enum.HumanoidStateType.Dead then return false end
        
        
        if char:FindFirstChildOfClass("ForceField") then return false end

        local player = Players:GetPlayerFromCharacter(char)
        if player and Options and Options.ESPTeamCheck and Options.ESPTeamCheck.Value and isSameTeamHelper then
            local mode = (Options.TeamCheckMode and Options.TeamCheckMode.Value) or "Auto Detect"
            local ok, sameTeam = pcall(isSameTeamHelper, player, true, mode)
            if ok and sameTeam then return false end
        end
        
        return true
    end
    
