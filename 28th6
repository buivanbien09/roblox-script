local function getSelectedAutoPickupWeapons(value)
    local selected = {}

    if type(value) == "table" then
        for weaponName, enabled in pairs(value) do
            if enabled == true then
                table.insert(selected, tostring(weaponName))
            elseif type(enabled) == "string" then
                table.insert(selected, tostring(enabled))
            end
        end
    elseif value then
        table.insert(selected, tostring(value))
    end

    table.sort(selected)
    if #selected <= 0 then
        selected = { "AK74U" }
    end

    return selected
end

