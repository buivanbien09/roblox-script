            tool.Parent = backpack

            local jorkin = false
            local track = nil
            local animObj = nil

            local function stopTomfoolery()
                jorkin = false
                if jorkinLoop then
                    task.cancel(jorkinLoop)
                    jorkinLoop = nil
                end
                if track then
                    pcall(function() track:Stop() end)
                    track = nil
                end
                if animObj then
                    pcall(function() animObj:Destroy() end)
                    animObj = nil
                end
            end

            trackConnection(tool.Equipped:Connect(function() 
