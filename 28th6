local function getAvailablePickupWeapons()
    local names = {}
    local seen = {}

    local function addTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        local name = tostring(tool.Name or "")
        if name ~= "" and not seen[name] then
            seen[name] = true
            table.insert(names, name)
        end
    end

    local function scanContainer(container)
        if not container then return end
        for _, object in ipairs(container:GetDescendants()) do
            if object:IsA("Tool") then
                addTool(object)
            end
        end
    end

    local players = game:GetService("Players")
    local localPlayer = players.LocalPlayer
    local replicatedStorage = game:GetService("ReplicatedStorage")
    scanContainer(replicatedStorage:FindFirstChild("Tools"))
    scanContainer(workspace)
    scanContainer(localPlayer and localPlayer.Character)
    scanContainer(localPlayer and localPlayer:FindFirstChildOfClass("Backpack"))

    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)

    if #names == 0 then
        names = { "R700" }
    end
    return names
end

