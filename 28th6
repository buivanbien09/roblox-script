local AMMO_NAMES = {
    "Ammo", "CurrentAmmo", "AmmoCount", "Clip", "Magazine",
    "AmmoValue", "Bullets", "CurrentClip", "AmmoInClip", "MaxAmmo"
}

local function parseAmmoValue(value)
    if value == nil then return nil end

    if typeof(value) == "number" then
        return value
    end

    if typeof(value) == "string" then
        local text = value:gsub("%s+", "")

        local current = text:match("(-?%d+)%s*[/|\\]%s*%d+")
        if current then return tonumber(current) end

        current = text:match("(-?%d+)")
        if current then return tonumber(current) end
    end

    return tonumber(value)
end

local function readNamedValue(root, names)
    if not root then return nil end

    for _, name in ipairs(names) do
        local value = parseAmmoValue(root:GetAttribute(name))
        if value ~= nil then return value end
    end

    for _, desc in ipairs(root:GetDescendants()) do
        for _, name in ipairs(names) do
            local value = parseAmmoValue(desc:GetAttribute(name))
            if value ~= nil then return value end
        end
    end

    for _, desc in ipairs(root:GetDescendants()) do
        local lname = string.lower(desc.Name)
        for _, name in ipairs(names) do
            local targetName = string.lower(name)
            if lname == targetName or lname:find(targetName, 1, true) then
                if desc:IsA("ValueBase") then
                    local value = parseAmmoValue(desc.Value)
                    if value ~= nil then return value end
                elseif desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
                    local value = parseAmmoValue(desc.Text)
                    if value ~= nil then return value end
                end
            end
        end
    end

    return nil
end

local function getAmmo(tool)
    return readNamedValue(tool, AMMO_NAMES)
end

local function getEquippedGun()
    local character = LocalPlayer and LocalPlayer.Character
