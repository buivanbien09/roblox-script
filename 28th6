do
    local upEnabled   = false
    local upDist      = 20    
    local upRadius    = 800
    local upTargetAll = true
    local liftSpeed   = 80    

    
    local upState     = "idle"
    local upTarget    = nil
    local upCurrentPos = nil  

    local function isBringAimHolding()
        
        return true
    end

    local function isBringTargetValid(char, myRoot, cam)
        if not char or not myRoot or not cam then return false end
        if not isValidTarget(char) then return false end

        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        if (myRoot.Position - root.Position).Magnitude > upRadius then return false end
        return true
    end

    local function getSmartBringTarget(myRoot, cam)
        if not myRoot or not cam then return nil end

        
        local aimTarget = (CS and CS.aimbotTarget) or HubState.AimbotTarget or _G.AimbotTarget
        if aimTarget and isBringTargetValid(aimTarget, myRoot, cam) then
            return aimTarget
        end

        
        if not upTargetAll then return nil end

        local aimPos = getAimScreenPosition()
        local bestChar = nil
        local bestScore = math.huge
        local fallbackChar = nil
        local fallbackDist = math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            if player ~= LocalPlayer and isBringTargetValid(char, myRoot, cam) then
                local root = char:FindFirstChild("HumanoidRootPart")
                local part = getAimPart(char) or root
                if root and part then
                    local worldDist = (myRoot.Position - root.Position).Magnitude
                    if worldDist < fallbackDist then
                        fallbackDist = worldDist
                        fallbackChar = char
                    end

                    local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - aimPos).Magnitude

                        
                        
                        local aimFov = (CS and CS.aimbotFov) or math.huge
                        local fovPenalty = screenDist <= aimFov and 0 or 500
                        local score = screenDist + fovPenalty + (worldDist * 0.03)
                        if score < bestScore then
                            bestScore = score
                            bestChar = char
                        end
                    end
                end
            end
        end

        return bestChar or fallbackChar
    end

    Tabs.Combat:AddSection("Bring To Crosshair")

    Tabs.Combat:AddToggle("UpEnabled", {
        Title = "Enable Bring To Crosshair", Default = false
    }):OnChanged(function()
        upEnabled = Options.UpEnabled.Value
        if not upEnabled then
            upState = "idle"
            upTarget = nil
            upCurrentPos = nil
        end
    end)

    Tabs.Combat:AddDropdown("UpTargetMode", {
        Title  = "Target Mode",
        Values = { "Closest Enemy", "Aimbot Target Only" },
        Default = "Closest Enemy",
        Multi  = false,
    }):OnChanged(function(v)
        upTargetAll = (v == "Closest Enemy")
    end)

    Tabs.Combat:AddSlider("UpDist", {
        Title = "Distance In Front (studs)", Default = 20, Min = 3, Max = 100, Rounding = 0,
        Callback = function(v) upDist = v end
    })

    Tabs.Combat:AddSlider("LiftSpeed", {
        Title = "Pull Speed (studs/s)", Default = 80, Min = 10, Max = 500, Rounding = 0,
        Callback = function(v) liftSpeed = v end
    })

    Tabs.Combat:AddSlider("UpRadius", {
        Title = "Search Radius (studs)", Default = 800, Min = 10, Max = 3000, Rounding = 0,
        Callback = function(v) upRadius = v end
    })

    
    trackConnection(RunService.Heartbeat:Connect(function(dt)
        if not upEnabled then return end

        if not isBringAimHolding() then
            upState = "idle"
            upTarget = nil
            upCurrentPos = nil
            return
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local cam = workspace.CurrentCamera or Camera
        if not cam then return end

        
        
        if upState ~= "idle" then
            local smartTarget = getSmartBringTarget(myRoot, cam)
            if smartTarget and smartTarget ~= upTarget then
                local r = smartTarget:FindFirstChild("HumanoidRootPart")
                if r then
                    upTarget = smartTarget
                    upCurrentPos = r.Position
                    upState = "pulling"
                end
            elseif not isBringTargetValid(upTarget, myRoot, cam) then
                upState = "idle"
                upTarget = nil
                upCurrentPos = nil
            end
        end

        
        if upState == "idle" then
            local foundChar = getSmartBringTarget(myRoot, cam)

            if foundChar then
                local r = foundChar:FindFirstChild("HumanoidRootPart")
                if r then
                    upTarget     = foundChar
                    upCurrentPos = r.Position  
                    upState      = "pulling"
                end
            end
            return
        end

        
        local enemyRoot = upTarget and upTarget:FindFirstChild("HumanoidRootPart")
        local hum       = upTarget and upTarget:FindFirstChildOfClass("Humanoid")
        if not enemyRoot or not hum or hum.Health <= 0 then
            upState = "idle"; upTarget = nil; upCurrentPos = nil
            return
        end

        
        
        local camPos    = cam.CFrame.Position
        local lookDir   = cam.CFrame.LookVector
        local targetPos = camPos + lookDir * math.max(upDist, 3)

        
        if upState == "pulling" then
            local toTarget = targetPos - upCurrentPos
            local dist     = toTarget.Magnitude
            local step     = liftSpeed * dt

            if dist <= step or dist < 1 then
                upCurrentPos = targetPos
                upState      = "holding"
            else
                upCurrentPos = upCurrentPos + toTarget.Unit * step
            end

            pcall(function()
                enemyRoot.CFrame = CFrame.new(upCurrentPos, camPos)
            end)

        
        
        elseif upState == "holding" then
            pcall(function()
                
                local holdPos = cam.CFrame.Position + cam.CFrame.LookVector * math.max(upDist, 3)
                enemyRoot.CFrame = CFrame.new(holdPos, cam.CFrame.Position)
            end)
        end
    end))
end
