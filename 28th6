local HubState do
    local env = (typeof(getgenv) == "function" and getgenv()) or _G
    env._28th6Hub = env._28th6Hub or {}
    HubState = env._28th6Hub

    if HubState.Loaded and HubState.LoadCompleted then
        warn("28th6Hub is already loaded. Cleaning up old session before reload.")
    end

    -- Invalidate all task.spawn loops created by older executions.
    HubState.SessionId = (HubState.SessionId or 0) + 1

    if HubState.Connections then
        for _, conn in ipairs(HubState.Connections) do
            pcall(function()
                if conn and conn.Disconnect then conn:Disconnect() end
            end)
        end
    end

    -- Clean up infinite-ammo value hooks from the previous hub session.
    if HubState.InfiniteAmmoConns then
        for _, entry in ipairs(HubState.InfiniteAmmoConns) do
            pcall(function() if entry.conn then entry.conn:Disconnect() end end)
        end
        HubState.InfiniteAmmoConns = {}
    end

    if HubState.RenderStepBinds then
        local rs = game:GetService("RunService")
        for _, bindName in ipairs(HubState.RenderStepBinds) do
            pcall(function() rs:UnbindFromRenderStep(bindName) end)
        end
    else
        pcall(function()
            local rs = game:GetService("RunService")
            rs:UnbindFromRenderStep("AimbotCamOverride")
        end)
    end

    HubState.Loaded = true
    HubState.LoadCompleted = false
    HubState.Connections = {}
    HubState.RenderStepBinds = {}
    HubState.AimbotTarget = nil
    HubState.IsValidTarget = nil
    HubState.GetAimPart = nil
    HubState.GetAimScreenPosition = nil
end

