local gunScanGeneration = 0
local function scanLiveGunNames()
    local found = {}
    local seen = {}

    local function addTools(container, source)
        if not container then return end
        for _, object in ipairs(container:GetDescendants()) do
            if object:IsA("Tool") then
                local path = object:GetFullName()
                if not seen[path] then
                    seen[path] = true
                    table.insert(found, {
                        name = object.Name,
                        path = path,
                        source = source
                    })
                end
            end
        end
    end

    local players = game:GetService("Players")
    local player = players.LocalPlayer
    local replicatedStorage = game:GetService("ReplicatedStorage")
    addTools(replicatedStorage:FindFirstChild("Tools"), "ReplicatedStorage")
    addTools(workspace, "Workspace")
    addTools(player and player.Character, "Character")
    addTools(player and player:FindFirstChildOfClass("Backpack"), "Backpack")

    table.sort(found, function(a, b)
        return (a.name .. a.path):lower() < (b.name .. b.path):lower()
    end)
    return found
end

