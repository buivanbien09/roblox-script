                    if effect:IsA("BlurEffect") then
                        if data.Size ~= nil then effect.Size = data.Size end
                    elseif effect:IsA("DepthOfFieldEffect") then
                        if data.FarIntensity ~= nil then effect.FarIntensity = data.FarIntensity end
                        if data.FocusDistance ~= nil then effect.FocusDistance = data.FocusDistance end
                        if data.InFocusRadius ~= nil then effect.InFocusRadius = data.InFocusRadius end
                        if data.NearIntensity ~= nil then effect.NearIntensity = data.NearIntensity end
