    trackConnection(RunService.Heartbeat:Connect(function()
        if not Options.SpeedBoostToggle or not Options.SpeedBoostToggle.Value then return end
        local root = getRootPart()
        local hum = getHumanoid()
        if not root or not hum then return end
        
        if currentMode == "WalkSpeed" then
            hum.WalkSpeed = currentSpeed
        elseif currentMode == "Velocity" then
            if hum.MoveDirection.Magnitude > 0 then
                local v = hum.MoveDirection * currentSpeed
                root.AssemblyLinearVelocity = Vector3.new(v.X, root.AssemblyLinearVelocity.Y, v.Z)
            end
        elseif currentMode == "CFrame" then
            if hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (currentSpeed * 0.01))
            end
        elseif currentMode == "LinearVelocity" then
            if hum.MoveDirection.Magnitude > 0 then
                if not speedLv or not speedLv.Parent then
                    speedAttach = Instance.new("Attachment", root)
                    speedLv = Instance.new("LinearVelocity", root)
                    speedLv.Attachment0 = speedAttach
                    speedLv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
                    speedLv.MaxAxesForce = Vector3.new(9999999, 0, 9999999)
                    speedLv.RelativeTo = Enum.ActuatorRelativeTo.World
                end
                speedLv.VectorVelocity = hum.MoveDirection * currentSpeed
            else
                cleanupSpeedLv()
            end
        elseif currentMode == "Bhop" then
            if hum.MoveDirection.Magnitude > 0 then
                local v = hum.MoveDirection * currentSpeed
                root.AssemblyLinearVelocity = Vector3.new(v.X, root.AssemblyLinearVelocity.Y, v.Z)
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end
        
        if currentMode ~= "LinearVelocity" then
            cleanupSpeedLv()
        end
    end))

