Tabs.Test:AddToggle("FullGameScannerToggle", {
    Title = "Full Game Scanner",
    Description = "Continuously scan remotes, tools, and GUIs; 0.25s delay",
    Default = false
}):OnChanged(function()
    fullGameScannerGeneration += 1
    local generation = fullGameScannerGeneration

    if Options.FullGameScannerToggle and Options.FullGameScannerToggle.Value then
        Fluent:Notify({ Title = "Scanner", Content = "Scanner enabled. M console F9  xem.", Duration = 4 })

        task.spawn(function()
            local scanned = {}
            scannerOutput = {}
            shopScannerOutput = {}

            local function getPath(obj)
                local ok, path = pcall(function()
                    return obj:GetFullName()
                end)
                return ok and path or tostring(obj)
            end

            local scanKeywords = {
                "lobby", "again", "win", "victory", "defeat", "result", "continue",
                "move", "movement", "slide", "sliding", "sprint", "run", "walk",
                "crouch", "dash", "jump", "attack", "hit", "damage", "skill", "ability",
                "buy", "purchase", "shop", "coin", "cash", "gem", "quest", "mission",
                "claim", "reward", "daily", "trade", "inventory", "equip", "unequip",
                "teleport", "tween", "spawn", "respawn", "cashout", "extract", "escape",
                "anticheat", "kick", "ban", "detect", "log"
            }

            local scanClasses = {
                RemoteEvent = true,
                RemoteFunction = true,
                BindableEvent = true,
                BindableFunction = true,
                UnreliableRemoteEvent = true,
                Tool = true,
                HopperBin = true,
                ScreenGui = true,
                BillboardGui = true,
                SurfaceGui = true,
                ProximityPrompt = true,
                ClickDetector = true,
                Sound = true,
                Animation = true,
                Animator = true,
            }

            local importantParents = {
                replicatedstorage = true,
                replicatedfirst = true,
                serverstorage = true,
                serverscriptservice = true,
                workspace = true,
                playergui = true,
                players = true,
            }

            local function shouldIgnoreScanObject(obj)
                local path = string.lower(getPath(obj))
                return path:find("coregui", 1, true)
                    or path:find("corepackages", 1, true)
                    or path:find("fluentrenewed", 1, true)
                    or path:find("menutogglegui", 1, true)
                    or path:find("mobilequickbuttons", 1, true)
                    or path:find("28th6", 1, true)
            end

            local function getObjectText(obj)
                local ok, text = pcall(function()
                    return tostring(obj.Text or "")
                end)
                return ok and text or ""
            end

            local function matchesKeyword(obj)
                local path = string.lower(getPath(obj))
                local haystack = string.lower(obj.Name .. " " .. getObjectText(obj) .. " " .. path)
                for _, keyword in ipairs(scanKeywords) do
                    if haystack:find(keyword, 1, true) then
                        return true, keyword
                    end
                end
                return false, nil
            end

            local function hasImportantParent(obj)
                local current = obj.Parent
                while current do
                    if importantParents[string.lower(current.Name)] then
                        return true, current.Name
                    end
                    current = current.Parent
                end
                return false, nil
            end

            local function isUsefulShopRemote(obj)
                if not (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
                    return false
                end

                local path = string.lower(getPath(obj))
                local name = string.lower(obj.Name)
                local shopContext = path:find("shop", 1, true)
                    or path:find("purchase", 1, true)
                    or path:find("buy", 1, true)
                    or path:find("product", 1, true)
                    or path:find("gift", 1, true)
                    or path:find("ownership", 1, true)
                local usefulName = name:find("buy", 1, true)
                    or name:find("purchase", 1, true)
                    or name:find("gift", 1, true)
                    or name:find("product", 1, true)
                    or name:find("ownership", 1, true)
                    or name:find("success", 1, true)
                    or name:find("notify", 1, true)
                return shopContext and usefulName
            end

            local function printIfNew(tag, obj, extra)
                local path = getPath(obj)
                if scanned[tag .. ":" .. path] then return end
                scanned[tag .. ":" .. path] = true

                local line = tag .. " " .. obj.ClassName .. " | " .. path .. (extra or "")
                local isShopRemote = isUsefulShopRemote(obj)

                -- Always retain the complete scan history; the filter only controls console output.
                table.insert(scannerOutput, line)
                if isShopRemote then
                    table.insert(shopScannerOutput, line)
                end

                if shopScannerOnly and not isShopRemote then return end
                print(line)
            end

            while sessionId == HubState.SessionId
                and generation == fullGameScannerGeneration
                and Options.FullGameScannerToggle and Options.FullGameScannerToggle.Value do
                for _, obj in ipairs(game:GetDescendants()) do
                    if not shouldIgnoreScanObject(obj) then
                        local classMatch = scanClasses[obj.ClassName]
                        local parentMatch, parentName = hasImportantParent(obj)
                        local keywordMatch, keyword = matchesKeyword(obj)

                        if classMatch and parentMatch then
                            printIfNew("[CLASS/" .. parentName .. "]", obj)
                        end

                        if keywordMatch then
                            printIfNew("[KEYWORD:" .. keyword .. "]", obj)
                        end

                        if obj:GetAttribute("ScannerTag") then
                            printIfNew("[ATTRIBUTE]", obj, " ScannerTag=" .. tostring(obj:GetAttribute("ScannerTag")))
                        end

                        if obj:IsA("StringValue") and #obj.Value > 20 then
                            printIfNew("[STRINGVALUE]", obj, " Length=" .. tostring(#obj.Value))
                        end
                    end
                end

                local collectionService = game:GetService("CollectionService")
                for _, tag in ipairs(collectionService:GetAllTags()) do
                    printIfNew("[TAG]", collectionService, " " .. tostring(tag))
                end

                task.wait(0.25)
            end

            Fluent:Notify({ Title = "Scanner", Content = "Scanner disabled.", Duration = 3 })
        end)
    else
        Fluent:Notify({ Title = "Scanner", Content = "Scanner disabled.", Duration = 3 })
    end
end)

