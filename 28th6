        -- Luôn ưu tiên Head
        local head = char:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end

        -- Fallback cho R15/R6
        for _, name in ipairs({"UpperTorso", "Torso", "HumanoidRootPart"}) do
            local p = char:FindFirstChild(name)
