    local legitVelX, legitVelY = 0, 0   
    local prevTargetChar = nil           

    bindRenderStep(
        "AimbotCamOverride",
        Enum.RenderPriority.Camera.Value + 1,
        function(deltaTime)
            Camera = workspace.CurrentCamera or Camera
            if not CS.aimbotEnabled or not Camera then return end

            
            local isAiming = true
            if CS.aimbotHoldEnabled and not isMobile then
                isAiming = UserInputService:IsMouseButtonPressed(
                    Enum.UserInputType.MouseButton2
                )
            end
            if not isAiming then
                
                CS.aimbotTarget  = nil
                HubState.AimbotTarget = nil
                _G.AimbotTarget  = nil
                return
            end

            
            local currentPart = CS.aimbotTarget and getAimPart(CS.aimbotTarget)
            local currentValid = false

            if currentPart and isValidTarget(CS.aimbotTarget) then
                if (not CS.aimbotVisibleOnly) or isVisible(currentPart) then
                    local sp, onScreen = Camera:WorldToViewportPoint(currentPart.Position)
                    if onScreen and sp.Z > 0 then
                        local mousePos = getAimScreenPosition()
                        local screenDist = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                        
                        if screenDist <= CS.aimbotFov * 1.25 then
                            currentValid = true
                        end
                    end
                end
            end

            
            
            
            if not currentValid then
                CS.aimbotTarget = getBestTarget()
            end

            if not CS.aimbotTarget then
                HubState.AimbotTarget = nil
                _G.AimbotTarget = nil
                return
            end

            local part = getAimPart(CS.aimbotTarget)
            if not part or not isValidTarget(CS.aimbotTarget) then
                CS.aimbotTarget = nil
                HubState.AimbotTarget = nil
                _G.AimbotTarget = nil
                return
            end
            
            HubState.AimbotTarget = CS.aimbotTarget
            _G.AimbotTarget = CS.aimbotTarget 
            if CS.aimbotVisibleOnly and not isVisible(part) then return end

            
            
            local safeDT = math.min(deltaTime, 1/30)
            local alpha = 1 - math.pow(1 - CS.aimbotSmoothness, safeDT * 60)
            alpha = math.clamp(alpha, 0.01, 0.35) 

            if CS.aimbotMethod == "Drag (Legit)" then
                
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then
                    local center = getAimScreenPosition()
                    local deltaX = sp.X - center.X
                    local deltaY = sp.Y - center.Y
                    local rawDist = math.sqrt(deltaX*deltaX + deltaY*deltaY)

                    
                    
                    local deadZone = 2.5
                    if rawDist > deadZone and rawDist < CS.aimbotFov * 1.5 then
                        local maxMove = CS.dragSpeed * safeDT

                        
                        
                        local easeZone = 20
                        local speedScale = 1.0
                        if rawDist < easeZone then
                            speedScale = math.max(0.15, rawDist / easeZone)
                        end

                        local moveLen = math.min(rawDist - deadZone, maxMove * speedScale)
                        if moveLen > 0 then
                            local dirX = deltaX / rawDist
                            local dirY = deltaY / rawDist
                            local moveX = dirX * moveLen
                            local moveY = dirY * moveLen
                            if hasMouseMoveRel then
                                mousemoverel(moveX, moveY)
                            else
                                pcall(function()
                                    local vim = game:GetService("VirtualInputManager")
                                    local curPos = UserInputService:GetMouseLocation()
                                    vim:SendMouseMoveEvent(curPos.X + moveX, curPos.Y + moveY, game)
                                end)
                            end
                        end
                    end
                end

            elseif CS.aimbotMethod == "Legit (Human-like)" then
                
                
                if CS.aimbotTarget ~= prevTargetChar then
                    legitVelX, legitVelY = 0, 0
                    prevTargetChar = CS.aimbotTarget
                end

                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then
                    local center = getAimScreenPosition()
                    local deltaX = sp.X - center.X
                    local deltaY = sp.Y - center.Y
                    local rawDist = math.sqrt(deltaX*deltaX + deltaY*deltaY)

                    if rawDist < CS.aimbotFov * 1.5 then
                        
                        local springK = 8.0   
                        local damping = 6.0   
                        local forceX = deltaX * springK - legitVelX * damping
                        local forceY = deltaY * springK - legitVelY * damping
                        legitVelX = legitVelX + forceX * safeDT
                        legitVelY = legitVelY + forceY * safeDT

                        
                        local velMag = math.sqrt(legitVelX*legitVelX + legitVelY*legitVelY)
                        if velMag > CS.legitMaxSpeed then
                            local scale = CS.legitMaxSpeed / velMag
                            legitVelX = legitVelX * scale
                            legitVelY = legitVelY * scale
                        end

                        
                        local moveX = legitVelX * safeDT
                        local moveY = legitVelY * safeDT

                        
                        if CS.legitJitter > 0 then
                            moveX = moveX + (math.random() * 2 - 1) * CS.legitJitter
                            moveY = moveY + (math.random() * 2 - 1) * CS.legitJitter
                        end

                        
                        moveX = math.clamp(moveX, -50, 50)
                        moveY = math.clamp(moveY, -50, 50)

                        if math.abs(moveX) > 0.05 or math.abs(moveY) > 0.05 then
                            if hasMouseMoveRel then
                                mousemoverel(moveX, moveY)
                            else
                                pcall(function()
                                    local vim = game:GetService("VirtualInputManager")
                                    local curPos = UserInputService:GetMouseLocation()
                                    vim:SendMouseMoveEvent(curPos.X + moveX, curPos.Y + moveY, game)
                                end)
                            end
                        end
                    end
                end

            elseif CS.aimbotMethod == "Mouse (mousemoverel)" and hasMouseMoveRel then
                
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and sp.Z > 0 then
                    local center = getAimScreenPosition()
                    local deltaX = sp.X - center.X
                    local deltaY = sp.Y - center.Y
                    
                    local rawDist = math.sqrt(deltaX*deltaX + deltaY*deltaY)
                    if rawDist < CS.aimbotFov * 1.5 then
                        local moveX = math.clamp(deltaX * alpha, -35, 35) 
                        local moveY = math.clamp(deltaY * alpha, -35, 35)
                        if math.abs(moveX) > 0.05 or math.abs(moveY) > 0.05 then
                            mousemoverel(moveX, moveY)
                        end
                    end
                end


            else
                
                local focusPos = Camera.Focus.Position
                local camPos = Camera.CFrame.Position
                local zoomDist = (camPos - focusPos).Magnitude
                local targetPos = part.Position

                local aimCF
                if zoomDist > 1.5 and (targetPos - focusPos).Magnitude > 0.5 then
                    local dir = (targetPos - focusPos).Unit
                    local desiredCamPos = focusPos - (dir * zoomDist)
                    aimCF = CFrame.new(desiredCamPos, targetPos)
                else
                    if (targetPos - camPos).Magnitude < 0.1 then return end
                    aimCF = CFrame.new(camPos, targetPos)
                end
                Camera.CFrame = Camera.CFrame:Lerp(aimCF, alpha)
            end


        end
    )



    
    
    
