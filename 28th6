    local function saveBlurEffect(effect)
        if antiBlurSaved[effect] then return end
        local data = { Enabled = effect.Enabled }
        if effect:IsA("BlurEffect") then
            data.Size = effect.Size
        elseif effect:IsA("DepthOfFieldEffect") then
            data.FarIntensity = effect.FarIntensity
            data.FocusDistance = effect.FocusDistance
            data.InFocusRadius = effect.InFocusRadius
            data.NearIntensity = effect.NearIntensity
        end
        antiBlurSaved[effect] = data
    end

    local function disableBlurEffect(effect)
        if not effect or not effect.Parent then return end
        if effect:IsA("BlurEffect") or effect:IsA("DepthOfFieldEffect") then
            saveBlurEffect(effect)
            pcall(function()
                effect.Enabled = false
                if effect:IsA("BlurEffect") then
                    effect.Size = 0
                end
            end)
        end
    end

